@model Alquiler_de_Canchas.Models.TipoCancha

@{
    ViewData["Title"] = "Editar Tipo de Cancha";
}

<h1>Editar Tipo de Cancha</h1>

<form asp-action="Edit" asp-route-id="@Model.IdTipoCancha" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="IdTipoCancha" />

    <div class="form-group mb-2">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}