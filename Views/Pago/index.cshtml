@{
    ViewData["Title"] = "Pagos";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

@Html.AntiForgeryToken()

<div id="app" v-cloak>
    <h1>Pagos</h1>

    <div v-if="mensaje" class="alert alert-success py-2">{{ mensaje }}</div>
    <div v-if="errorLista" class="alert alert-danger py-2">{{ errorLista }}</div>

    <!-- Filtros -->
    <div class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" v-model="filtro.fechaDesde" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" v-model="filtro.fechaHasta" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tipo</label>
                <select class="form-select" v-model="filtro.tipo">
                    <option value="">Todos</option>
                    <option v-for="t in tipos" v-bind:key="t.valor" v-bind:value="t.valor">{{ t.texto }}</option>
                </select>
            </div>
            <div class="col-md-auto">
                <button class="btn btn-primary" v-on:click="aplicarFiltro">Buscar</button>
                <button class="btn btn-outline-secondary" v-on:click="limpiarFiltro">Limpiar</button>
            </div>
            <div class="col-md text-end">
                <button class="btn btn-success" v-on:click="abrirNuevo">Registrar pago</button>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Turno</th>
                <th>Tipo</th>
                <th>Método</th>
                <th class="text-end">Monto</th>
                <th>Registrado por</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr v-if="cargando"><td colspan="7" class="text-center">Cargando...</td></tr>
            <tr v-else-if="items.length === 0"><td colspan="7" class="text-center text-muted">No hay pagos.</td></tr>

            <tr v-for="p in items" v-bind:key="p.idPago">
                <td>{{ formatoFecha(p.fechaPago) }}</td>
                <td>{{ p.turnoTexto }}</td>
                <td><span class="badge" v-bind:class="claseTipo(p.tipoTransaccion)">{{ p.tipoTexto }}</span></td>
                <td>{{ p.metodoPago }}</td>
                <td class="text-end" v-bind:class="{ 'text-danger': p.tipoTransaccion === 2 }">
                    {{ p.tipoTransaccion === 2 ? '-' : '' }}{{ formatoMonto(p.monto) }}
                </td>
                <td>{{ p.usuarioTexto }}</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary" v-on:click="abrirEditar(p)">Editar</button>
                    <button v-if="esAdmin" class="btn btn-sm btn-outline-danger" v-on:click="eliminar(p)">Eliminar</button>
                </td>
            </tr>
        </tbody>
    </table>

    <!-- Paginado -->
    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted">{{ total }} pago(s) - Página {{ pagina }} de {{ Math.max(totalPaginas, 1) }}</span>
        <div>
            <button class="btn btn-outline-secondary btn-sm" v-bind:disabled="pagina <= 1" v-on:click="irAPagina(pagina - 1)">Anterior</button>
            <button class="btn btn-outline-secondary btn-sm" v-bind:disabled="pagina >= totalPaginas" v-on:click="irAPagina(pagina + 1)">Siguiente</button>
        </div>
    </div>

    <!-- Modal alta / edición -->
    <div class="modal fade" id="modalPago" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ form.idPago ? 'Editar pago' : 'Registrar pago' }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div v-if="errorForm" class="alert alert-danger py-2">{{ errorForm }}</div>

                    <div class="mb-3">
                        <label class="form-label">Turno</label>
                        <select2-ajax v-model="form.idTurno"
                                      v-bind:texto="form.turnoTexto"
                                      url="@Url.Action("BuscarTurnos", "Pago")"
                                      placeholder="Buscar por cliente o nº de cancha..."
                                      parent="#modalPago"></select2-ajax>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Monto</label>
                            <input type="number" min="0.01" step="0.01" class="form-control" v-model.number="form.monto" />
                        </div>
                        <div class="col">
                            <label class="form-label">Fecha de pago</label>
                            <input type="date" class="form-control" v-model="form.fechaPago" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Método de pago</label>
                            <select class="form-select" v-model="form.metodoPago">
                                <option v-for="m in metodos" v-bind:key="m" v-bind:value="m">{{ m }}</option>
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label">Tipo de transacción</label>
                            <select class="form-select" v-model="form.tipoTransaccion">
                                <option v-for="t in tipos" v-bind:key="t.valor" v-bind:value="t.valor">{{ t.texto }}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn btn-primary" v-bind:disabled="guardando" v-on:click="guardar">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        const urls = {
            listar: '@Url.Action("Listar", "Pago")',
            crear: '@Url.Action("Crear", "Pago")',
            editar: '@Url.Action("Editar", "Pago")',
            eliminar: '@Url.Action("Eliminar", "Pago")'
        };
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        async function api(url, opciones = {}) {
            const resp = await fetch(url, {
                ...opciones,
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }
            });
            const data = await resp.json().catch(() => ({}));
            if (!resp.ok) throw new Error(data.mensaje || 'Ocurrió un error inesperado.');
            return data;
        }

        // Componente Select2 con búsqueda asíncrona en el servidor
        const Select2Ajax = {
            props: {
                modelValue: { type: [Number, String], default: null },
                url: String,
                placeholder: String,
                texto: { type: String, default: '' },
                parent: { type: String, default: null },
                allowClear: { type: Boolean, default: false }
            },
            emits: ['update:modelValue'],
            template: '<select style="width:100%"><option></option></select>',
            mounted() {
                const $el = $(this.$el);
                $el.select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: this.placeholder,
                    allowClear: this.allowClear,
                    dropdownParent: this.parent ? $(this.parent) : undefined,
                    ajax: {
                        url: this.url,
                        dataType: 'json',
                        delay: 250,
                        data: p => ({ term: p.term || '', pagina: p.page || 1 }),
                        processResults: d => ({ results: d.results, pagination: { more: d.more } })
                    }
                });
                $el.on('select2:select', e => this.$emit('update:modelValue', parseInt(e.params.data.id)));
                $el.on('select2:clear', () => this.$emit('update:modelValue', null));
                this.precargar();
            },
            watch: {
                modelValue(v) {
                    if (v === null || v === '') $(this.$el).val(null).trigger('change');
                },
                texto() { this.precargar(); }
            },
            methods: {
                precargar() {
                    if (this.modelValue && this.texto) {
                        const $el = $(this.$el);
                        $el.empty().append(new Option(this.texto, this.modelValue, true, true)).trigger('change');
                    }
                }
            },
            beforeUnmount() { $(this.$el).select2('destroy'); }
        };

        const { createApp, reactive, ref, onMounted } = Vue;

        createApp({
            components: { Select2Ajax },
            setup() {
                const tipos = [
                    { valor: 0, texto: 'Seña' },
                    { valor: 1, texto: 'Pago total' },
                    { valor: 2, texto: 'Reembolso' }
                ];
                const metodos = ['Efectivo', 'Transferencia', 'Tarjeta de débito', 'Tarjeta de crédito', 'Mercado Pago'];

                const esAdmin = ref(false);
                const items = ref([]);
                const total = ref(0);
                const pagina = ref(1);
                const totalPaginas = ref(1);
                const tamPagina = 10;
                const cargando = ref(false);
                const errorLista = ref('');
                const mensaje = ref('');

                const filtro = reactive({ fechaDesde: '', fechaHasta: '', tipo: '' });

                const hoy = () => new Date().toLocaleDateString('en-CA'); // yyyy-MM-dd
                const formVacio = () => ({
                    idPago: 0, idTurno: null, turnoTexto: '', monto: null,
                    fechaPago: hoy(), metodoPago: 'Efectivo', tipoTransaccion: 1
                });
                const form = reactive(formVacio());
                const errorForm = ref('');
                const guardando = ref(false);
                let modal = null;

                function mostrarMensaje(texto) {
                    mensaje.value = texto;
                    setTimeout(() => { mensaje.value = ''; }, 4000);
                }

                async function cargar() {
                    cargando.value = true;
                    errorLista.value = '';
                    try {
                        const p = new URLSearchParams({ pagina: pagina.value, tamPagina });
                        if (filtro.fechaDesde) p.set('fechaDesde', filtro.fechaDesde);
                        if (filtro.fechaHasta) p.set('fechaHasta', filtro.fechaHasta);
                        if (filtro.tipo !== '') p.set('tipo', filtro.tipo);

                        const data = await api(urls.listar + '?' + p.toString());
                        items.value = data.items;
                        total.value = data.total;
                        totalPaginas.value = data.totalPaginas;
                        esAdmin.value = data.esAdmin;
                        if (pagina.value > 1 && data.items.length === 0 && data.totalPaginas > 0) {
                            pagina.value = data.totalPaginas;
                            return cargar();
                        }
                    } catch (e) {
                        errorLista.value = e.message;
                    } finally {
                        cargando.value = false;
                    }
                }

                function aplicarFiltro() {
                    errorLista.value = '';
                    if (filtro.fechaDesde && filtro.fechaHasta && filtro.fechaDesde > filtro.fechaHasta) {
                        errorLista.value = 'La fecha "desde" no puede ser posterior a "hasta".';
                        return;
                    }
                    pagina.value = 1;
                    cargar();
                }

                function limpiarFiltro() {
                    filtro.fechaDesde = ''; filtro.fechaHasta = ''; filtro.tipo = '';
                    aplicarFiltro();
                }

                function irAPagina(n) {
                    if (n < 1 || n > totalPaginas.value) return;
                    pagina.value = n;
                    cargar();
                }

                function abrirNuevo() {
                    Object.assign(form, formVacio());
                    errorForm.value = '';
                    modal.show();
                }

                function abrirEditar(p) {
                    Object.assign(form, {
                        idPago: p.idPago,
                        idTurno: p.idTurno, turnoTexto: p.turnoTexto,
                        monto: p.monto, fechaPago: p.fechaPago,
                        metodoPago: p.metodoPago, tipoTransaccion: p.tipoTransaccion
                    });
                    // si el método guardado no está en la lista, se agrega para no perderlo
                    if (!metodos.includes(form.metodoPago)) metodos.push(form.metodoPago);
                    errorForm.value = '';
                    modal.show();
                }

                async function guardar() {
                    errorForm.value = '';
                    guardando.value = true;
                    try {
                        const cuerpo = {
                            idPago: form.idPago, idTurno: form.idTurno, monto: form.monto || 0,
                            fechaPago: form.fechaPago, metodoPago: form.metodoPago,
                            tipoTransaccion: form.tipoTransaccion
                        };
                        const data = await api(form.idPago ? urls.editar : urls.crear,
                                               { method: 'POST', body: JSON.stringify(cuerpo) });
                        modal.hide();
                        mostrarMensaje(data.mensaje);
                        await cargar();
                    } catch (e) {
                        errorForm.value = e.message;
                    } finally {
                        guardando.value = false;
                    }
                }

                async function eliminar(p) {
                    if (!confirm('¿Eliminar el pago de ' + formatoMonto(p.monto) + ' del ' + formatoFecha(p.fechaPago) + '?')) return;
                    try {
                        const data = await api(urls.eliminar + '/' + p.idPago, { method: 'POST' });
                        mostrarMensaje(data.mensaje);
                        await cargar();
                    } catch (e) {
                        errorLista.value = e.message;
                    }
                }

                const formatoFecha = f => f.split('-').reverse().join('/');
                const formatoMonto = m => '$ ' + Number(m).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const claseTipo = t => ['bg-warning text-dark', 'bg-success', 'bg-danger'][t];

                onMounted(() => {
                    modal = new bootstrap.Modal(document.getElementById('modalPago'));
                    cargar();
                });

                return {
                    tipos, metodos, esAdmin, items, total, pagina, totalPaginas, cargando, errorLista, mensaje,
                    filtro, form, errorForm, guardando,
                    aplicarFiltro, limpiarFiltro, irAPagina,
                    abrirNuevo, abrirEditar, guardar, eliminar, formatoFecha, formatoMonto, claseTipo
                };
            }
        }).mount('#app');
    </script>
}
