@model Alquiler_de_Canchas.Models.Cancha
@{
    ViewData["Title"] = "Dar de baja Cancha";
}

<h1>Dar de baja Cancha</h1>

<div class="alert alert-warning">
    ¿Estás seguro de que querés dar de baja esta cancha?
</div>

<dl class="row">
    <dt class="col-sm-2">Número</dt>
    <dd class="col-sm-10">@Model.Numero</dd>
    <dt class="col-sm-2">Tipo</dt>
    <dd class="col-sm-10">@Model.TipoCancha?.Nombre</dd>
    <dt class="col-sm-2">Superficie</dt>
    <dd class="col-sm-10">@Model.TipoSuperficie</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.IdCancha" method="post">
    <button type="submit" class="btn btn-danger">Confirmar baja</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
