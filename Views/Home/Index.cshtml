@{
    ViewData["Title"] = "Inicio";
    bool logueado = User.Identity != null && User.Identity.IsAuthenticated;
    string nombre = User.FindFirst(ClaimTypes.Name)?.Value ?? "";
}

<section class="hero-pitch">
    <div class="hero-content">
        <h1>Tu cancha,<br />a la hora justa.</h1>

        @if (logueado)
        {
            <p class="hero-lead">Hola, @nombre. Gestioná canchas, turnos y pagos desde un solo lugar.</p>
            <div class="hero-actions">
                <a class="btn btn-ball" asp-controller="Usuario" asp-action="MiPerfil">Mi perfil</a>
                @if (User.IsInRole("Administrador"))
                {
                    <a class="btn btn-line" asp-controller="Usuario" asp-action="Index">Gestionar usuarios</a>
                }
            </div>
        }
        else
        {
            <p class="hero-lead">Administrá canchas, turnos y pagos desde un solo lugar.</p>
            <div class="hero-actions">
                <a class="btn btn-ball" asp-controller="Usuario" asp-action="Login">Iniciar sesión</a>
                <a class="btn btn-line" asp-controller="Usuario" asp-action="Register">Registrarme</a>
            </div>
        }
    </div>
</section>
